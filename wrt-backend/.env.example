# ============================================
# WRT Garage Backend — Environment Variables Template
# ============================================
# Copy this file to .env and fill in the values

# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
BODY_LIMIT=5mb

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://wrt_user:wrt_secret@localhost:5432/wrt_garage
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=wrt_user
POSTGRES_PASSWORD=wrt_secret
POSTGRES_DB=wrt_garage
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=3000

# AI Engine Configuration (gemini or openrouter)
AI_PROVIDER=gemini
AI_TIMEOUT_MS=45000

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# OpenRouter AI Configuration (Alternative Provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# API Security
API_KEY_SECRET=wrt-garage-api-key-change-this-in-production

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=15

# Workshop / Bengkel Info (for Receipts & Reports)
SHOP_NAME=WRT DIAGNOSIS AGENT AI
SHOP_ADDRESS=Jl. Otista Raya No. 88 | WA: 0812-3456-7890

# Thermal & Network Printer (ZPL II / ESC-POS)
PRINTER_DEFAULT_IP=192.168.1.100
PRINTER_DEFAULT_PORT=9100
PRINTER_TIMEOUT_MS=5000

# Logging
LOG_LEVEL=debug
