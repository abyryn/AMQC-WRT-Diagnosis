# ============================================
# WRT Garage Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL Database
DATABASE_URL=postgresql://wrt_user:wrt_secret@localhost:5432/wrt_garage
POSTGRES_USER=wrt_user
POSTGRES_PASSWORD=wrt_secret
POSTGRES_DB=wrt_garage

# Google Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
AI_PROVIDER=gemini

# API Security
API_KEY_SECRET=wrt-garage-api-key-change-this-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Logging
LOG_LEVEL=debug
