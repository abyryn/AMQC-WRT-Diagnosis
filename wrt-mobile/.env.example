# ============================================
# WRT Garage — Mobile & Web App Environment Template
# ============================================
# Copy this file to .env and fill in the values

# Web Server Port
PORT=8080

# Backend API Configuration
# By default, client uses window.location.hostname:3000/api
# Set this to an explicit URL if backend is on a different domain or server
API_BASE_URL=http://localhost:3000/api

# Shared API Security Key (must match backend API_KEY_SECRET)
API_KEY=wrt-garage-api-key-change-this-in-production

# Network Thermal Printer Default Target
DEFAULT_PRINTER_IP=192.168.1.100
DEFAULT_PRINTER_PORT=9100

